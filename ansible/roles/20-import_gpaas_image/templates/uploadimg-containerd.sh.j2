#! /bin/sh
harborUrl={{ HARBOR_URL }} #harbor地址，如使用kk部署的harbor, 应填 "dockerhub.kubekey.local"
harborUsName={{ HARBOR_USNAME }}  #harbor用户名
harborPsw={{ HARBOR_PSW }}  #harbor密码
proName={{ HARBOR_PRONAME }} #harbor中的项目名称,可以自行在harbor创建
for fileName in $(ls {{ DEST_PATH }}/images);
do
	echo $fileName
	
	temp=$(ctr image import {{ DEST_PATH }}/images/$fileName)
	oldimgName=$(echo $temp | awk '{print $2}')
	echo $oldimgName
	
	newimgName="$harborUrl/$proName/${oldimgName##*/}"
	echo $newimgName
	sudo ctr images tag $oldimgName $newimgName
	sudo ctr images push $newimgName --user $harborUsName:$harborPsw
	
done

